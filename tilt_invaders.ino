/*
  Tilt Invaders - 3D space invaders for the Waveshare ESP32-S3-LCD-1.28 (GC9A01 round LCD + QMI8658 IMU)

  The screen is a window onto an un-named desert planet:
    - held LEVEL (flat) you look straight down at the sand
    - raise the top edge: the horizon appears at the top of the screen and lowers, the sky and the invaders come into view
    - tilt left / right to turn (up to 60 degrees each way); you can look up to 60 degrees above the horizon
    - BOOT fires the laser straight ahead (where the crosshair is). Two hits destroy an invader.
  The invaders shift left, shift right, then come a little closer to the ground; if one lands it is game over.
  They shoot straight at you: a bolt grows where the invader was, and it only hits if your crosshair is on
  that spot when it arrives. Every hit costs a bonus (you start with 3); clearing a level gives one back (max 10).
  Level 1 has one invader, level 2 has two, and so on: there is no end.

  BOOT button: fire (in the game) / start again (after game over). Hold it ~1.5 s to recalibrate "level".

  Files in this sketch folder:
    tilt_invaders.ino   this file (hardware, tilt input, main loop)
    inv_game.h          the game rules and the invaders' behaviour
    inv_render.h        the 3D drawing
    inv_sprites.h       the pixel art

  Library needed: "GFX Library for Arduino" (moononournation)
  Board: ESP32S3 Dev Module, USB CDC On Boot = Disabled, Flash 16MB, PSRAM optional.
*/

#include <Arduino_GFX_Library.h>
#include <Wire.h>
#include "esp_heap_caps.h"

#include "inv_render.h"

// Newer Arduino_GFX versions removed the short colour names, so define the ones we use
#ifndef BLACK
#define BLACK  0x0000
#define WHITE  0xFFFF
#define RED    0xF800
#endif

// ---------------- Pins (non-touch ESP32-S3-LCD-1.28) ----------------
#define PIN_SCK   10
#define PIN_MOSI  11
#define PIN_CS     9
#define PIN_DC     8
#define PIN_RST   12
#define PIN_BL    40
#define PIN_SDA    6
#define PIN_SCL    7
#define PIN_BOOT   0

// ---------------- How the tilt steers the view ----------------
// Pitch: flat = looking straight down (-90 deg). Every degree you raise the top edge lifts the view by PITCH_GAIN
// degrees, so you do not need to tilt the board past upright to look 60 degrees above the horizon.
// Yaw: tilting the board left/right turns the view by YAW_GAIN degrees per degree of tilt.
const float PITCH_GAIN  = 1.5f;
const float YAW_GAIN    = 4.0f;
const float PITCH_MIN   = -90.0f;     // straight down
const float PITCH_MAX   = 60.0f;      // 60 degrees above the horizon
const float YAW_MAX     = 60.0f;      // 60 degrees left and right
#define INVERT_PITCH 0                // set to 1 if raising the top edge lowers the view
#define INVERT_YAW   1                // set to 1 if tilting right turns the view left
const float VIEW_TAU    = 0.5f;      // seconds of smoothing on the view
#define DEBUG_SERIAL 1

// ---------------- Display ----------------
Arduino_DataBus *bus = new Arduino_ESP32SPI(PIN_DC, PIN_CS, PIN_SCK, PIN_MOSI, GFX_NOT_DEFINED);
Arduino_GFX *gfx = new Arduino_GC9A01(bus, PIN_RST, 0 /*rotation*/, true /*IPS*/);

